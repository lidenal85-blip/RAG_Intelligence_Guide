#!/usr/bin/env python3
"""
generate_chapters.py
Генератор глав учебника RAG Intelligence Guide.
Запуск: python3 /tmp/RAG_book/generate_chapters.py
"""
import os, sys, time, re
import urllib.request, urllib.error, json
from pathlib import Path

BASE = Path("/tmp/RAG_book")
GEMINI_MODEL = "gemini-2.5-flash"

# Читаем ключ из .env
_KEY_IDX = 0
_KEYS: list[str] = []

def _load_keys() -> list[str]:
    env = Path("/opt/leviathan_engine/agent_service/.env").read_text()
    keys = []
    for line in env.splitlines():
        for i in range(1, 15):
            if line.startswith(f"GEMINI_K{i}="):
                k = line.split("=", 1)[1].strip()
                if k and not k.startswith("#"):
                    keys.append(k)
    return keys

def get_key() -> str:
    global _KEY_IDX, _KEYS
    if not _KEYS:
        _KEYS = _load_keys()
        if not _KEYS:
            raise RuntimeError("Нет Gemini ключей")
        print(f"[KEYS] Загружено {len(_KEYS)} ключей")
    key = _KEYS[_KEY_IDX % len(_KEYS)]
    _KEY_IDX += 1
    return key

